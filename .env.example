# MODE=demo   -> fully offline, simulated quotes and settlement (default; no keys needed)
# MODE=quotes -> real 1Click quotes (dry run) + NEAR AI Cloud reasoning. No funds move.
# MODE=live   -> real quotes, real deposits from the agent sub-account. Testnet/small funds only.
MODE=demo
PORT=3000

# NEAR AI Cloud (https://cloud.near.ai -> API Keys). Optional in demo mode; without it a rules brain is used.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.2

# NEAR Intents 1-Click API. JWT is optional; without one a 0.2% fee applies.
ONECLICK_JWT=

# Agent sub-account (needed for MODE=live and for `npm run derive`)
NEAR_NETWORK=mainnet
NEAR_ACCOUNT_ID=agent.yourname.near
NEAR_PRIVATE_KEY=ed25519:...
# Chain Signatures path: one path = one set of foreign-chain addresses
CHAINSIG_PATH=allowance-1
